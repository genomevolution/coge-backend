/*
 * Nextflow Configuration
 * Configuration for genome indexing pipeline
 */

params {
    // Default parameters
    fasta_file = null
    organism_id = null
    genome_id = null
    output_dir = "results"
    
    // Working directory (needs ~3x genome size in space)
    work_dir = '/data/nextflow_work'
}

// Process defaults
process {
    errorStrategy = 'retry'
    maxRetries = 2
    
    withName: 'BGZIP_WITH_INDEX' {
        cpus = 4
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    
    withName: 'SAMTOOLS_FAIDX' {
        cpus = 1
        memory = { 2.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
        docker.enabled = false
    }
    
    local {
        process.executor = 'local'
        docker.enabled = false
    }
    
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'genomics'
        singularity.enabled = true
        singularity.autoMounts = true
    }
    
    k8s {
        process.executor = 'k8s'
        k8s.namespace = 'coge-processing'
        docker.enabled = true
    }
}

// Execution reports
trace {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

report {
    enabled = true
    overwrite = true
}

timeline {
    enabled = true
    overwrite = true
}

dag {
    enabled = true
    overwrite = true
}

// Manifest
manifest {
    name = 'COGE Genome Indexing Pipeline'
    author = 'COGE Backend'
    description = 'Generate bgzip compressed FASTA files with indexes for JBrowse visualization'
    version = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
